{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build and Run Active File",
      "command": "clang++ -std=c++20 -O3 \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}